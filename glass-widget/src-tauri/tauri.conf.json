{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "磨砂玻璃组件",
  "version": "0.1.0",
  "identifier": "com.example.frostedglasswidget",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "",
      "width": 200,
      "height": 200,
      "resizable": false,
      "decorations": false,
      "transparent": true,
      "shadow": false,
      "alwaysOnTop": true
    }],
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' https: http: data: blob:" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
